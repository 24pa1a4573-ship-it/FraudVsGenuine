# ──────────────────────────────────────────────────────────────
# Returns Fraud Sorter — .gitignore
# ──────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data (large files — download separately)
data/raw/*.csv
data/processed/*.csv
data/processed/*.json

# Trained models (large binary files)
models/*.pkl
models/*.json
models/*.txt

# Streamlit cache
.streamlit/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
